{
  "name": "inkfish-android",
  "version": "0.1.0",
  "private": true,
  "description": "Inkfish Android client (Expo + TypeScript) — local-only V1, same plain-.md vault format as Mac",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild --platform android --clean",
    "android": "expo prebuild --platform android --clean && expo run:android",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "expo": "^58.0.0",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.11",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-share-intent": "^9.0.0",
    "expo-system-ui": "~58.0.6",
    "lucide-react-native": "^1.57.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
