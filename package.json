{
  "name": "inkfish",
  "version": "0.1.0",
  "description": "Inkfish — menu-bar quick capture with AI inbox-to-project note flow (bun + electron)",
  "license": "MIT",
  "author": "PylotLight <lochois@gmail.com>",
  "type": "module",
  "main": "./out/main/index.js",
  "bin": {
    "inkfish": "./bin/inkfish.mjs"
  },
  "files": [
    "out/**/*",
    "bin/**/*",
    "build/icon.png",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:bare": "electron-vite dev",
    "build": "bun scripts/build-stt.ts && electron-vite build",
    "start": "electron ./out/main/index.js",
    "preview": "electron-vite preview",
    "clean": "rm -rf out",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "assets": "bun scripts/make-tray-icon.ts",
    "icon": "bun scripts/make-app-icon.ts",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:ci": "electron-builder --publish never",
    "release": "bun scripts/release.ts",
    "postinstall": "install-electron",
    "stt:build": "bun scripts/build-stt.ts"
  },
  "build": {
    "appId": "com.pylotlight.inkfish",
    "productName": "Inkfish",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Inkfish records voice notes when you press the mic button.",
        "NSSpeechRecognitionUsageDescription": "Inkfish transcribes your voice notes on this Mac.",
        "NSAudioCaptureUsageDescription": "Inkfish records the other side of your meetings when you start meeting capture."
      },
      "extraResources": [
        {
          "from": "stt/bin",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@karanganesan/vocule": "^1.0.0",
    "@moonshine-ai/moonshine-wasm": "^0.1.5",
    "@types/bun": "latest",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "codemirror": "^6.0.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "parakeet.js": "^1.4.4",
    "typescript": "~5.9.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
