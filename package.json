{
  "name": "bun-electron-app",
  "version": "0.1.0",
  "description": "Pure Bun + Electron + React + Vite + TypeScript",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview && electron ./out/main/index.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "install-electron"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/bun": "latest",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
