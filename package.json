{
  "name": "inkfish",
  "private": true,
  "version": "0.2.17",
  "description": "Inkfish — menu-bar quick capture with AI inbox-to-project note flow (bun + electron)",
  "license": "MIT",
  "author": "PylotLight <lochois@gmail.com>",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:bare": "electron-vite dev",
    "build": "bun scripts/build-stt.ts && electron-vite build",
    "start": "electron ./out/main/index.js",
    "preview": "electron-vite preview",
    "clean": "rm -rf out",
    "test": "bun test",
    "typecheck": "bun check",
    "typecheck:android": "bun check -p android",
    "assets": "bun scripts/make-tray-icon.ts",
    "icon": "bun scripts/make-app-icon.ts",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:ci": "electron-builder --publish never",
    "release": "bun scripts/release.ts",
    "postinstall": "install-electron",
    "stt:build": "bun scripts/build-stt.ts",
    "bench:stt": "bun scripts/bench-stt.ts",
    "bench:stt:web": "bun scripts/bench-web-stt.ts",
    "test:electron-ai": "electron scripts/electron-ai-smoke.mjs",
    "test:electron-window": "bun scripts/electron-window-smoke.mjs",
    "test:cli": "bun test ./packages/cli/test",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "build": {
    "appId": "com.pylotlight.inkfish",
    "productName": "Inkfish",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "build/icon.png",
      "assets/tray*.png",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Inkfish records voice notes when you press the mic button.",
        "NSSpeechRecognitionUsageDescription": "Inkfish transcribes your voice notes on this Mac.",
        "NSAudioCaptureUsageDescription": "Inkfish records the other side of your meetings when you start meeting capture."
      },
      "extraResources": [
        {
          "from": "stt/bin",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@karanganesan/vocule": "^1.0.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "qrcode": "^1.5.4",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@lezer/highlight": "^1.2.5",
    "@noble/ciphers": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
